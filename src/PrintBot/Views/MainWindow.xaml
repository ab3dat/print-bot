<Window x:Class="PrintBot.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PrintBot.ViewModels"
        xmlns:converters="clr-namespace:PrintBot.Converters"
        Title="Print-Bot" Height="700" Width="1000"
        MinHeight="500" MinWidth="800"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <converters:BooleanNegationConverter x:Key="BooleanNegationConverter" />
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:StatusToEmojiConverter x:Key="StatusToEmojiConverter" />
        <converters:FileTypeToIconConverter x:Key="FileTypeToIconConverter" />
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />   <!-- Toolbar -->
            <RowDefinition Height="*" />       <!-- Queue -->
            <RowDefinition Height="Auto" />   <!-- Status bar -->
        </Grid.RowDefinitions>

        <!-- ═══ Toolbar ═══ -->
        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <!-- File actions + queue actions -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: File import -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button Content="📁 Dateien hinzufügen" Width="160"
                            Command="{Binding AddFilesCommand}" Margin="0,0,8,0" />
                    <Button Content="📂 Ordner hinzufügen" Width="160"
                            Command="{Binding AddFolderCommand}" />
                </StackPanel>

                <!-- Right: Queue actions -->
                <!-- NOTE: DataGrid.SelectedItems is not a DependencyProperty, so it cannot be
                     data-bound as a CommandParameter (it won't update WPF's binding engine when
                     the selection changes). Instead we use Click handlers in code-behind that
                     read JobsGrid.SelectedItems directly and invoke the ViewModel commands. -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="⬆ Nach oben" Width="90" Margin="0,0,4,0"
                            Click="MoveUpButton_Click" />
                    <Button Content="⬇ Nach unten" Width="90" Margin="0,0,8,0"
                            Click="MoveDownButton_Click" />
                    <Button Content="🔁 Erneut drucken" Width="120" Margin="0,0,8,0"
                            Click="PrintSelectedButton_Click" />
                    <Button Content="✕ Entfernen" Width="90" Margin="0,0,8,0"
                            Click="RemoveSelectedButton_Click" />
                    <Button Content="🗑 Queue leeren" Width="100"
                            Command="{Binding ClearQueueCommand}" />
                </StackPanel>
            </Grid>

            <!-- Separator -->
            <Separator Margin="0,8" />

            <!-- Printer + Settings -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Label Content="Drucker:" VerticalAlignment="Center" Margin="0,0,4,0" />
                <ComboBox Grid.Column="1" Width="180"
                          ItemsSource="{Binding Printers}"
                          SelectedItem="{Binding SelectedPrinter}"
                          DisplayMemberPath="Name" />

                <Button Grid.Column="2" Content="⚙ Druckereinstellungen" Width="160"
                        Command="{Binding OpenPrintSettingsCommand}"
                        Margin="12,0,0,0" />

                <StackPanel Grid.Column="5" Orientation="Horizontal">
                    <CheckBox Content="🔃 Rückwärts" VerticalAlignment="Center" Margin="0,0,12,0"
                              IsChecked="{Binding ReverseOrder}"
                              IsEnabled="{Binding IsPrinting, Converter={StaticResource BooleanNegationConverter}}"
                              ToolTip="Startet 'Alles drucken' mit dem letzten Dokument der Liste" />
                    <Button Content="▶ Alles drucken" Width="130"
                            Command="{Binding PrintAllCommand}"
                            IsEnabled="{Binding IsPrinting, Converter={StaticResource BooleanNegationConverter}}"
                            FontWeight="Bold" Margin="0,0,6,0" />
                    <Button Content="✕ Abbrechen" Width="90"
                            Command="{Binding CancelCommand}"
                            IsEnabled="{Binding IsPrinting}" />
                </StackPanel>
            </Grid>
        </StackPanel>

        <!-- ═══ Print Queue ═══ -->
        <DataGrid Grid.Row="1"
                  x:Name="JobsGrid"
                  ItemsSource="{Binding PrintJobs}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  SelectionMode="Extended"
                  IsReadOnly="True"
                  GridLinesVisibility="Horizontal"
                  AlternatingRowBackground="#F5F5F5">

            <DataGrid.Columns>
                <!-- Icon + filename in one cell; full path available as a tooltip on hover
                     instead of a dedicated column, since it's mostly redundant with the name. -->
                <DataGridTemplateColumn Header="Dateiname" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" ToolTip="{Binding FullPath}">
                                <Image Source="{Binding FileType, Converter={StaticResource FileTypeToIconConverter}}"
                                       Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="{Binding FileName}" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- PDF page count (fast, read from the file header); Word/Excel leave this
                     blank since getting a real count would require opening them via COM. -->
                <DataGridTextColumn Header="Seiten" Width="55"
                                    Binding="{Binding EstimatedPages, TargetNullValue='–'}"
                                    IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Status column with emoji icons -->
                <DataGridTemplateColumn Header="Status" Width="90">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Status, Converter={StaticResource StatusToEmojiConverter}}"
                                           Margin="0,0,4,0" />
                                <TextBlock Text="{Binding Status}" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Fehler" Width="200" Binding="{Binding ErrorMessage}" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- ═══ Status Bar ═══ -->
        <StatusBar Grid.Row="2" Margin="0,8,0,0">
            <StatusBar.ItemsPanel>
                <ItemsPanelTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                    </Grid>
                </ItemsPanelTemplate>
            </StatusBar.ItemsPanel>

            <StatusBarItem Grid.Column="0">
                <TextBlock Text="{Binding StatusText}" />
            </StatusBarItem>

            <StatusBarItem Grid.Column="1" HorizontalAlignment="Right">
                <ProgressBar Width="200" Height="16"
                             Value="{Binding ProgressValue}"
                             Maximum="{Binding ProgressMax}"
                             Visibility="{Binding IsPrinting, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </StatusBarItem>

            <StatusBarItem Grid.Column="1" HorizontalAlignment="Right">
                <TextBlock Text="{Binding PrintJobs.Count, StringFormat={}{0} Dateien in Queue}" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
