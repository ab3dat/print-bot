<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <AssemblyName>PrintBot</AssemblyName>
    <RootNamespace>PrintBot</RootNamespace>
    <Version>0.1.0</Version>
    <Authors>Nozzy + Alex</Authors>
    <Description>Bulk print tool for Windows — PDF, Word, Excel with queue management</Description>
  </PropertyGroup>

  <!-- A valid binary .ico can't be authored through this remote editing environment (only plain
       text files can be created here), so an ApplicationIcon reference is intentionally omitted
       for now. See Assets\README.md for how to generate one locally, then uncomment the
       PropertyGroup below (make sure Assets\printbot.ico is a real, valid icon file first — a
       garbled/placeholder .ico at that path will break `dotnet build`). -->
  <!--
  <PropertyGroup>
    <ApplicationIcon>Assets\printbot.ico</ApplicationIcon>
  </PropertyGroup>
  -->

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
    <PackageReference Include="PdfiumViewer" Version="2.13.0" />
    <PackageReference Include="PdfiumViewer.Native.x86_64.v8-xfa" Version="2018.4.8.256" />
    <PackageReference Include="Microsoft.Office.Interop.Word" Version="15.0.4797.1004" />
    <PackageReference Include="Microsoft.Office.Interop.Excel" Version="15.0.4797.1004" />
    <PackageReference Include="Serilog" Version="3.1.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="5.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
  </ItemGroup>

</Project>
